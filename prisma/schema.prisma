generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String

  sessions Session[]

  skinProfile String?
  avatar      String?

  routines            Routine[]
  journal             SkinJournal[]
  subscription        Subscription?
  passwordResetTokens PasswordResetToken[]
  aiQueryLogs         AiQueryLog[]
  faceAnalyses        FaceAnalysis[]
  credits             Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Routine {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String @default("My Routine")

  routine  String
  metadata String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SkinJournal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime @default(now())
  entry      String
  photos     String
  concerns   String
  aiAnalysis String?
  rating     Int?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier                 String  @default("free")
  stripePriceId        String?
  stripeSubscriptionId String?
  status               String  @default("active")

  trialEndsAt DateTime?
  endsAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id       String @id @default(cuid())
  asin     String @unique
  name     String
  brand    String
  price    Float
  discount Float?

  category String

  ingredients String
  concerns    String
  skinTypes   String

  reviewUrl String?
  imageUrl  String?
  rating    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([category])
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AiQueryLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("search") // e.g., "search", "routine", "chat", "journal"
  query     String   @db.Text
  response  String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  type      String   // "newsletter", "hardwater", "dupe"
  data      String?  // JSON string containing details like city, score, savings
  createdAt DateTime @default(now())
}

model FaceAnalysis {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl      String
  barrierScore  Int      // 0-100
  acneScore     Int      // 0-100
  rednessScore  Int      // 0-100
  oilinessScore Int      // 0-100
  detailedJson  Json     // Full parsed analysis output
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// ─── B2B SaaS ─────────────────────────────────────────────────────────────────

model B2BApiKey {
  id          String   @id @default(cuid())
  key         String   @unique   // e.g. "b2b_live_xK9z..."
  email       String             // client contact email
  brandName   String             // e.g. "Cult Beauty"
  tier        String   @default("growth")  // "growth" | "scale" | "custom"
  billing     String   @default("monthly") // "monthly" | "annual"

  // Quota tracking
  monthlyQuota  Int      @default(150000) // 150k for growth, 1M for scale
  usageThisMonth Int     @default(0)
  quotaResetAt  DateTime @default(now())  // reset on the 1st of each month

  // Payment linkage
  razorpaySubscriptionId String?
  status        String   @default("active") // "active" | "suspended" | "cancelled"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageLogs B2BUsageLog[]

  @@index([email])
  @@index([key])
}

model B2BUsageLog {
  id        String   @id @default(cuid())
  keyId     String
  key       B2BApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  endpoint  String   // e.g. "/api/v1/recommend"
  skinType  String?
  city      String?
  ppm       Float?   // water hardness passed in call
  createdAt DateTime @default(now())

  @@index([keyId])
  @@index([keyId, createdAt])
}
