# =========================
# DATABASE (Supabase / Postgres)
# =========================
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# =========================
# AUTH / SECURITY
# =========================
JWT_SECRET="your_jwt_secret_here"

# =========================
# SUPABASE
# =========================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# =========================
# PAYMENTS (Razorpay)
# =========================
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_PRO_PLAN_ID="plan_your_pro_plan_id"
RAZORPAY_PLAN_ID="plan_your_plan_id"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# =========================
# SITE & EMAIL
# =========================
NEXT_PUBLIC_SITE_URL="https://www.mirhaandco.com"
RESEND_API_KEY="re_your_resend_api_key_here"
PASSWORD_RESET_FROM="noreply@mirhaandco.com"

# =========================
# AI / GEMINI
# =========================
GEMINI_API_KEY="your_gemini_api_key_here"

# =========================
# PAYMENTS (Paddle)
# =========================
PADDLE_API_KEY="your_paddle_api_key_here"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="your_paddle_client_token_here"
NEXT_PUBLIC_PADDLE_PRODUCT_ID="pro_your_paddle_product_id"
NEXT_PUBLIC_PADDLE_ONETIME_PRICE_ID="pri_your_paddle_price_id"
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID="pri_your_paddle_monthly_price_id"

# =========================
# PAYMENTS (Dodo Payments)
# =========================
DODO_PAYMENTS_API_KEY="your_dodo_api_key_here"
NEXT_PUBLIC_DODO_PRODUCT_ID="pdt_your_dodo_product_id"
DODO_WEBHOOK_SECRET="whsec_your_dodo_webhook_secret_here"

DODO_B2B_GROWTH_PRODUCT_ID="pdt_your_dodo_growth_id"
DODO_B2B_SCALE_PRODUCT_ID="pdt_your_dodo_scale_id"
DODO_B2B_GROWTH_ANNUAL_PRODUCT_ID="pdt_your_dodo_growth_annual_id"
DODO_B2B_SCALE_ANNUAL_PRODUCT_ID="pdt_your_dodo_scale_annual_id"
# Short-lived signed token secret for post-checkout B2B key retrieval.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
B2B_KEY_LOOKUP_SECRET=
