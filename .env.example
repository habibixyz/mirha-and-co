# =========================
# DATABASE (Supabase / Postgres)
# =========================
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# =========================
# AUTH / SECURITY
# =========================
JWT_SECRET="your_jwt_secret_here"

# =========================
# SUPABASE
# =========================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# =========================
# PAYMENTS (Razorpay)
# =========================
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_PRO_PLAN_ID="plan_xxxxxx"
RAZORPAY_PLAN_ID="plan_xxxxxx"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# =========================
# SITE & EMAIL
# =========================
NEXT_PUBLIC_SITE_URL="https://www.mirhaandco.com"
RESEND_API_KEY="re_xxxxxx"
PASSWORD_RESET_FROM="noreply@mirhaandco.com"

# =========================
# AI / GEMINI
# =========================
GEMINI_API_KEY="your_gemini_api_key"

# =========================
# PAYMENTS (Paddle)
# =========================
PADDLE_API_KEY="pdl_live_apikey_xxxxxx"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="live_xxxxxx"
NEXT_PUBLIC_PADDLE_PRODUCT_ID="pro_xxxxxx"
NEXT_PUBLIC_PADDLE_ONETIME_PRICE_ID="pri_xxxxxx"
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID="pri_xxxxxx"

# =========================
# PAYMENTS (Dodo Payments)
# =========================
DODO_PAYMENTS_API_KEY="your_dodo_api_key"
NEXT_PUBLIC_DODO_PRODUCT_ID="pdt_xxxxxx"
DODO_WEBHOOK_SECRET="whsec_xxxxxx"

DODO_B2B_GROWTH_PRODUCT_ID="pdt_xxxxxx"
DODO_B2B_SCALE_PRODUCT_ID="pdt_xxxxxx"
DODO_B2B_GROWTH_ANNUAL_PRODUCT_ID="pdt_xxxxxx"
DODO_B2B_SCALE_ANNUAL_PRODUCT_ID="pdt_xxxxxx"
